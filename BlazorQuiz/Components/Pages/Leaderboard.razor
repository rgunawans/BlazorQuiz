@page "/leaderboard"
@page "/leaderboard/{SessionCode}"
@using BlazorQuiz.Models
@using BlazorQuiz.Services
@layout Components.Layout.EmptyLayout
@inject NavigationManager Navigation
@inject IQuizService QuizService
@inject IQuizEventBus EventBus
@implements IAsyncDisposable
@inject IActivityLogService ActivityLogService
@rendermode InteractiveServer

<PageTitle>Leaderboard - Quiz System</PageTitle>

<div class="container mt-4">
    <div class="d-flex justify-content-end align-items-center gap-2 mb-2"><ThemeToggle /><LanguageSwitcher /></div>
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header leaderboard-header text-white py-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h2 class="mb-0">
                                <i class="bi bi-trophy-fill me-2"></i>
                                Leaderboard
                            </h2>
                            @if (quizSession != null)
                            {
                                <p class="mb-0 mt-1 opacity-90">
                                    <small>Quiz: <strong>@(quizSession.Quiz?.Title ?? L.T("Memuat...", "Loading..."))</strong></small>
                                </p>
                                <p class="mb-0 opacity-75">
                                    <small>@L.T("Kode Sesi:", "Session Code:") <strong>@quizSession.SessionCode</strong></small>
                                </p>
                            }
                        </div>
                        @if (totalParticipants > 0)
                        {
                            <div class="text-end">
                                <div class="fs-1 fw-bold">@totalParticipants</div>
                                <small>@L.T("Total Peserta", "Total Participants")</small>
                            </div>
                        }
                    </div>
                </div>

                <div class="card-body p-0">
                    @if (!hasSessionCode)
                    {
                        <!-- Session Code Input -->
                        <div class="p-4">
                            <div class="row justify-content-center">
                                <div class="col-md-6">
                                    <div class="text-center mb-4">
                                        <i class="bi bi-search display-1 text-muted mb-3"></i>
                                        <h4>@L.T("Masukkan Kode Sesi", "Enter Session Code")</h4>
                                        <p class="text-muted">@L.T("Masukkan kode sesi quiz untuk melihat leaderboard", "Enter the quiz session code to view the leaderboard")</p>
                                    </div>
                                    <div class="input-group input-group-lg mb-3">
                                        <input type="text" class="form-control text-center fs-4 fw-bold"
                                               placeholder="@L.T("Kode Sesi", "Session Code")"
                                               @bind="sessionCodeInput"
                                               @bind:event="oninput"
                                               @onkeypress="OnSessionCodeKeyPress" />
                                        <button class="btn btn-primary" type="button" @onclick="LoadLeaderboard" disabled="@loadingLeaderboard">
                                            @if (loadingLeaderboard)
                                            {
                                                <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                            }
                                            else
                                            {
                                                <i class="bi bi-search me-1"></i>
                                            }
                                            @L.T("Cari", "Search")
                                        </button>
                                    </div>
                                    @if (!string.IsNullOrEmpty(errorMessage))
                                    {
                                        <div class="alert alert-danger text-center">
                                            <i class="bi bi-exclamation-triangle me-2"></i>
                                            @errorMessage
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                    else if (loadingLeaderboard)
                    {
                        <!-- Loading State -->
                        <div class="text-center py-5">
                            <div class="spinner-border text-primary mb-3" role="status" style="width: 3rem; height: 3rem;">
                                <span class="visually-hidden">@L.T("Memuat...", "Loading...")</span>
                            </div>
                            <h5>@L.T("Memuat leaderboard...", "Loading leaderboard...")</h5>
                        </div>
                    }
                    else if (leaderboardEntries.Any())
                    {
                        <!-- Leaderboard Table -->
                        <div class="leaderboard-cards d-sm-none">
                            @foreach (var (entry, index) in leaderboardEntries.Select((entry, index) => (entry, index)))
                            {
                                <div class="leaderboard-card @(index < 3 ? "leaderboard-podium" : "")">
                                    <div class="leaderboard-card-rank">@(index + 1)</div>
                                    <div class="leaderboard-card-main">
                                        <div class="fw-bold">@entry.ParticipantName</div>
                                        <small class="text-muted">
                                            @entry.CorrectAnswers @L.T("dari", "of") @entry.TotalAnswers @L.T("benar", "correct"), @entry.Accuracy.ToString("F1")%
                                        </small>
                                    </div>
                                    <div class="leaderboard-card-score">
                                        <div class="fs-4 fw-bold text-primary">@entry.TotalScore</div>
                                        <small class="text-muted">@L.T("poin", "pts")</small>
                                    </div>
                                </div>
                            }
                        </div>

                        <div class="table-responsive d-none d-sm-block">
                            <table class="table table-hover mb-0 leaderboard-table">
                                <thead class="table-light sticky-top">
                                    <tr>
                                        <th class="text-center lb-w-80">@L.T("Peringkat", "Rank")</th>
                                        <th class="lb-w-60"></th>
                                        <th>@L.T("Nama Peserta", "Participant")</th>
                                        <th class="text-center lb-w-120">@L.T("Total Poin", "Total Points")</th>
                                        <th class="text-center lb-w-120">@L.T("Benar", "Correct")</th>
                                        <th class="text-center lb-w-120">@L.T("Total Jawaban", "Total Answers")</th>
                                        <th class="text-center lb-w-100">@L.T("Akurasi", "Accuracy")</th>
                                        <th class="text-center lb-w-120">@L.T("Rata-rata Waktu", "Avg. Time")</th>
                                        <th class="text-center lb-w-140">@L.T("Jawaban Terakhir", "Last Answer")</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var (entry, index) in leaderboardEntries.Select((entry, index) => (entry, index)))
                                    {
                                        var isTopThree = index < 3;
                                        var isEvenRow = index % 2 == 0;

                                        <tr class="@(isTopThree ? "leaderboard-podium" : "") @(isEvenRow ? "table-row-even" : "table-row-odd")">
                                            <td class="text-center align-middle py-3">
                                                @if (index == 0)
                                                {
                                                    <div class="rank-badge rank-gold">
                                                        <i class="bi bi-trophy-fill"></i>
                                                        <div class="rank-number">1</div>
                                                    </div>
                                                }
                                                else if (index == 1)
                                                {
                                                    <div class="rank-badge rank-silver">
                                                        <i class="bi bi-trophy-fill"></i>
                                                        <div class="rank-number">2</div>
                                                    </div>
                                                }
                                                else if (index == 2)
                                                {
                                                    <div class="rank-badge rank-bronze">
                                                        <i class="bi bi-trophy-fill"></i>
                                                        <div class="rank-number">3</div>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="rank-badge rank-regular">
                                                        <div class="rank-number">@(index + 1)</div>
                                                    </div>
                                                }
                                            </td>
                                            <td class="align-middle">
                                                <div class="participant-avatar-large">
                                                    @entry.ParticipantName.Substring(0, 1).ToUpper()
                                                </div>
                                            </td>
                                            <td class="align-middle">
                                                <div class="fw-bold fs-5">@entry.ParticipantName</div>
                                                @if (index < 3)
                                                {
                                                    <small class="text-muted">
                                                        @if (index == 0)
                                                        {
                                                            <i class="bi bi-trophy-fill text-warning me-1"></i><text>@L.T("Juara 1", "1st Place")</text>
                                                        }
                                                        else if (index == 1)
                                                        {
                                                            <i class="bi bi-trophy-fill text-secondary me-1"></i><text>@L.T("Juara 2", "2nd Place")</text>
                                                        }
                                                        else
                                                        {
                                                            <i class="bi bi-trophy-fill text-primary me-1"></i><text>@L.T("Juara 3", "3rd Place")</text>
                                                        }
                                                    </small>
                                                }
                                            </td>
                                            <td class="text-center align-middle">
                                                <div class="score-display">
                                                    <div class="fs-3 fw-bold text-primary">@entry.TotalScore</div>
                                                    <small class="text-muted">@L.T("poin", "pts")</small>
                                                </div>
                                            </td>
                                            <td class="text-center align-middle">
                                                <div class="fs-4 fw-bold text-success">@entry.CorrectAnswers</div>
                                            </td>
                                            <td class="text-center align-middle">
                                                <div class="fs-4 fw-bold">@entry.TotalAnswers</div>
                                            </td>
                                            <td class="text-center align-middle">
                                                <div class="accuracy-display">
                                                    <div class="circular-progress" style="--progress: @(entry.Accuracy)">
                                                        <span class="fw-bold">@entry.Accuracy.ToString("F1")%</span>
                                                    </div>
                                                </div>
                                            </td>
                                            <td class="text-center align-middle">
                                                <div class="time-display">
                                                    <div class="fs-6 fw-bold">@((entry.AverageTimeMs / 1000.0).ToString("F1"))s</div>
                                                    <small class="text-muted">@L.T("rata-rata", "average")</small>
                                                </div>
                                            </td>
                                            <td class="text-center align-middle">
                                                <small class="text-muted">
                                                    @if (entry.LastAnswerTime != DateTime.MinValue)
                                                    {
                                                        @GetRelativeTime(entry.LastAnswerTime)
                                                    }
                                                    else
                                                    {
                                                        <span>-</span>
                                                    }
                                                </small>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <!-- Statistics Footer -->
                        <div class="card-footer bg-light">
                            <div class="row text-center">
                                <div class="col-md-3">
                                    <div class="statistic-item">
                                        <div class="fs-2 fw-bold text-primary">@totalParticipants</div>
                                        <small class="text-muted">@L.T("Total Peserta", "Total Participants")</small>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="statistic-item">
                                        <div class="fs-2 fw-bold text-success">@(leaderboardEntries.Where(e => e.TotalScore > 0).Count())</div>
                                        <small class="text-muted">@L.T("Peserta Aktif", "Active Participants")</small>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="statistic-item">
                                        <div class="fs-2 fw-bold text-warning">@(leaderboardEntries.Any() ? leaderboardEntries.Max(e => e.TotalScore) : 0)</div>
                                        <small class="text-muted">@L.T("Skor Tertinggi", "Highest Score")</small>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="statistic-item">
                                        <div class="fs-2 fw-bold text-info">@(leaderboardEntries.Any() ? leaderboardEntries.Where(e => e.TotalAnswers > 0).Average(e => e.Accuracy).ToString("F1") : "0")%</div>
                                        <small class="text-muted">@L.T("Akurasi Rata-rata", "Average Accuracy")</small>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <!-- No Data State -->
                        <div class="text-center py-5">
                            <i class="bi bi-inbox display-1 text-muted mb-3"></i>
                            <h4>@L.T("Belum Ada Data", "No Data Yet")</h4>
                            <p class="text-muted">@L.T("Belum ada peserta yang menjawab pertanyaan dalam quiz ini.", "No participant has answered a question in this quiz yet.")</p>
                        </div>
                    }
                </div>
            </div>

            <!-- Action Buttons -->
            @if (hasSessionCode)
            {
                <div class="text-center mt-4">
                    <button class="btn btn-primary btn-lg me-2" @onclick="RefreshLeaderboard" disabled="@loadingLeaderboard">
                        @if (loadingLeaderboard)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                        }
                        else
                        {
                            <i class="bi bi-arrow-clockwise me-2"></i>
                        }
                        @L.T("Muat Ulang", "Refresh")
                    </button>

                    @* BARU: Next Question Button *@
                    @if (quizSession != null && !quizCompleted)
                    {
                        <button class="btn btn-success btn-lg me-2 next-question-btn" @onclick="NextQuestion" disabled="@processingNextQuestion">
                            @if (processingNextQuestion)
                            {
                                <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                            }
                            else
                            {
                                @if (hasMoreQuestions)
                                {
                                    <i class="bi bi-arrow-right me-2"></i>
                                }
                                else
                                {
                                    <i class="bi bi-flag-checkered me-2"></i>
                                }
                            }
                            @if (hasMoreQuestions)
                            {
                                <text>@L.T("Pertanyaan Selanjutnya", "Next Question")</text>
                            }
                            else
                            {
                                <text>@L.T("Selesai Quiz", "Finish Quiz")</text>
                            }
                        </button>
                    }

                    <button class="btn btn-outline-secondary btn-lg me-2" @onclick="ResetSession">
                        <i class="bi bi-arrow-left me-2"></i>
                        @L.T("Sesi Lain", "Other Session")
                    </button>
                    <button class="btn btn-outline-info btn-lg" onclick="window.print()">
                        <i class="bi bi-printer me-2"></i>
                        @L.T("Cetak", "Print")
                    </button>
                </div>
            }

            @* BARU: Quiz Status Info *@
            @if (hasSessionCode && quizSession != null)
            {
                <div class="text-center mt-3">
                    <div class="card border-info quiz-status-card">
                        <div class="card-body py-2">
                            <div class="row align-items-center">
                                <div class="col-md-4">
                                    <small class="text-muted">@L.T("Status Quiz:", "Quiz Status:")</small>
                                    <div class="fw-bold @(quizCompleted ? "text-success" : "text-primary")">
                                        @if (quizCompleted)
                                        {
                                            <i class="bi bi-check-circle me-1"></i>
                                            <text>@L.T("Selesai", "Completed")</text>
                                        }
                                        else
                                        {
                                            <i class="bi bi-play-circle me-1"></i>
                                            <text>@L.T("Sedang Berlangsung", "In Progress")</text>
                                        }
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <small class="text-muted">@L.T("Pertanyaan:", "Question:")</small>
                                    <div class="fw-bold text-info">
                                        @currentQuestionNumber @L.T("dari", "of") @totalQuestions
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <small class="text-muted">@L.T("Peserta Aktif:", "Active Participants:")</small>
                                    <div class="fw-bold text-primary">
                                        @(leaderboardEntries.Where(e => e.TotalScore > 0).Count()) @L.T("dari", "of") @totalParticipants
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<style>
    .leaderboard-header {
        background-color: var(--kahoot-blue);
    }

    .lb-w-60 { width: 60px; }
    .lb-w-80 { width: 80px; }
    .lb-w-100 { width: 100px; }
    .lb-w-120 { width: 120px; }
    .lb-w-140 { width: 140px; }

    .leaderboard-card {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.75rem 1rem;
        border-bottom: 1px solid var(--kahoot-border);
    }

    .leaderboard-card-rank {
        flex: 0 0 2rem;
        font-size: 1.25rem;
        font-weight: 800;
        text-align: center;
    }

    .leaderboard-card-main {
        flex: 1 1 auto;
        min-width: 0;
        overflow-wrap: anywhere;
    }

    .leaderboard-card-score {
        flex: 0 0 auto;
        text-align: right;
    }

    .leaderboard-table {
        font-size: 0.95rem;
    }

    .leaderboard-podium {
        background-color: color-mix(in srgb, var(--medal-gold) 10%, transparent);
        border-left: 4px solid var(--medal-gold);
    }

    .table-row-even {
        background-color: var(--kahoot-track);
    }

    .rank-badge {
        display: inline-flex;
        flex-direction: column;
        align-items: center;
        width: 50px;
        height: 50px;
        border-radius: 50%;
        justify-content: center;
        position: relative;
    }

    /* Medal gradients are kept on purpose: they encode the top-3 rank hierarchy. */
    .rank-gold {
        background: linear-gradient(135deg, var(--medal-gold) 0%, #ffed4e 100%);
        color: #1f1f1f;
    }

    .rank-silver {
        background: linear-gradient(135deg, var(--medal-silver) 0%, #e5e5e5 100%);
        color: #1f1f1f;
    }

    .rank-bronze {
        background: linear-gradient(135deg, var(--medal-bronze) 0%, #deb887 100%);
        color: #1f1f1f;
    }

    .rank-regular {
        background-color: var(--kahoot-bg);
        color: var(--kahoot-muted);
        border: 2px solid var(--kahoot-border);
    }

    .rank-number {
        font-size: 1rem;
        font-weight: bold;
        line-height: 1;
    }

    .participant-avatar-large {
        width: 40px;
        height: 40px;
        background-color: var(--kahoot-blue);
        color: white;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
        font-size: 1.2rem;
    }

    .score-display {
        padding: 0.5rem;
    }

    .accuracy-display {
        display: flex;
        justify-content: center;
    }

    .circular-progress {
        width: 50px;
        height: 50px;
        border-radius: 50%;
        background: conic-gradient(var(--kahoot-green) calc(var(--progress) * 3.6deg), var(--kahoot-track) 0deg);
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
    }

    .circular-progress::before {
        content: '';
        width: 36px;
        height: 36px;
        border-radius: 50%;
        background: var(--kahoot-card);
        position: absolute;
    }

    .circular-progress span {
        position: relative;
        z-index: 1;
        font-size: 0.75rem;
        font-weight: bold;
        color: var(--kahoot-green);
    }

    .time-display {
        padding: 0.25rem;
    }

    .statistic-item {
        padding: 1rem;
        border-radius: 0.375rem;
        margin: 0.25rem;
        background: var(--kahoot-card);
        border: 1px solid var(--kahoot-border);
    }

    /* BARU: Styling untuk quiz navigation */
    .quiz-navigation-info {
        background-color: var(--kahoot-accent-tint);
        border: 2px solid var(--kahoot-blue);
        border-radius: 0.5rem;
    }

    .next-question-btn {
        transition: all 0.3s ease;
    }

    .next-question-btn:hover:not(:disabled) {
        transform: translateY(-2px);
    }

    .quiz-status-card {
        background-color: var(--kahoot-card);
    }
</style>

@code {
    [Parameter] public string? SessionCode { get; set; }

    private QuizSession? quizSession;
    private List<LeaderboardEntry> leaderboardEntries = new();
    private IDisposable? eventSubscription;
    private bool disposed;
    private Timer? refreshTimer;

    private string sessionCodeInput = string.Empty;
    private bool hasSessionCode = false;
    private bool loadingLeaderboard = false;
    private string errorMessage = string.Empty;
    private int totalParticipants = 0;

    // BARU: Variables for quiz navigation
    private bool quizCompleted = false;
    private int currentQuestionNumber = 0;
    private int totalQuestions = 0;
    private bool hasMoreQuestions = true;
    private bool processingNextQuestion = false;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await ActivityLogService.LogActivityAsync("Leaderboard page initialized", "Leaderboard page accessed", "Info", source: "Leaderboard");

            // Check if session code is provided in URL
            if (!string.IsNullOrEmpty(SessionCode))
            {
                sessionCodeInput = SessionCode;
                hasSessionCode = true;
                await LoadLeaderboard();
            }
        }
        catch (Exception ex)
        {
            await ActivityLogService.LogActivityAsync("Leaderboard initialization error", ex.Message, "Error", source: "Leaderboard");
            errorMessage = L.T("Terjadi kesalahan saat memuat halaman.", "An error occurred while loading the page.");
        }
    }

    private void SubscribeToEvents()
    {
        eventSubscription?.Dispose();
        eventSubscription = null;
        if (quizSession == null) return;

        eventSubscription = EventBus.Subscribe(quizSession.Id, e =>
        {
            if (disposed) return Task.CompletedTask;
            return InvokeAsync(async () =>
            {
                if (disposed) return;
                switch (e.Type)
                {
                    case QuizEventType.LeaderboardUpdated:
                        await RefreshLeaderboardData();
                        StateHasChanged();
                        break;
                    case QuizEventType.StatusUpdate:
                        currentQuestionNumber = e.CurrentQuestionNumber;
                        totalQuestions = e.TotalQuestions;
                        quizCompleted = e.Completed;
                        hasMoreQuestions = e.CurrentQuestionNumber < e.TotalQuestions;
                        StateHasChanged();
                        break;
                    case QuizEventType.QuizCompleted:
                        quizCompleted = true;
                        hasMoreQuestions = false;
                        StateHasChanged();
                        break;
                }
            });
        });
    }

    private async Task OnSessionCodeKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await LoadLeaderboard();
        }
    }

    private async Task LoadLeaderboard()
    {
        if (string.IsNullOrWhiteSpace(sessionCodeInput))
        {
            errorMessage = L.T("Masukkan kode sesi!", "Enter the session code!");
            return;
        }

        try
        {
            loadingLeaderboard = true;
            errorMessage = string.Empty;
            StateHasChanged();

            // Find the quiz session
            quizSession = await QuizService.GetQuizSessionAsync(sessionCodeInput.Trim().ToUpper());

            if (quizSession == null)
            {
                errorMessage = L.T("Kode sesi tidak ditemukan!", "Session code not found!");
                hasSessionCode = false;
                return;
            }

            hasSessionCode = true;
            await RefreshLeaderboardData();

            // BARU: Load quiz status information
            await LoadQuizStatus();

            SubscribeToEvents();

            // Start periodic refresh (replace any previous timer so they don't pile up)
            refreshTimer?.Dispose();
            refreshTimer = new Timer(async _ => await RefreshLeaderboardData(), null, TimeSpan.Zero, TimeSpan.FromSeconds(5));

            // Update URL
            Navigation.NavigateTo($"/leaderboard/{sessionCodeInput.Trim().ToUpper()}", false);

            await ActivityLogService.LogActivityAsync("Leaderboard loaded", $"Session: {quizSession.SessionCode}, Quiz: {quizSession.Quiz?.Title}", "Info", source: "Leaderboard");
        }
        catch (Exception ex)
        {
            await ActivityLogService.LogActivityAsync("Load leaderboard error", ex.Message, "Error", source: "Leaderboard");
            errorMessage = L.T("Terjadi kesalahan saat memuat leaderboard.", "An error occurred while loading the leaderboard.");
            hasSessionCode = false;
        }
        finally
        {
            loadingLeaderboard = false;
            StateHasChanged();
        }
    }

    // BARU: Load quiz status information
    private async Task LoadQuizStatus()
    {
        try
        {
            if (quizSession?.Quiz != null)
            {
                totalQuestions = quizSession.Quiz.Questions.Count;
                currentQuestionNumber = Math.Min(quizSession.CurrentQuestionIndex + 1, totalQuestions);
                quizCompleted = !quizSession.IsActive;
                hasMoreQuestions = currentQuestionNumber < totalQuestions && !quizCompleted;
            }
        }
        catch (Exception ex)
        {
            await ActivityLogService.LogActivityAsync("Load quiz status error", ex.Message, "Error", source: "Leaderboard");
        }
    }

    // BARU: Method to trigger next question
    private async Task NextQuestion()
    {
        if (quizSession == null || processingNextQuestion) return;

        try
        {
            processingNextQuestion = true;
            StateHasChanged();

            // Send signal to QuizHost to advance to next question
            // The host page is not alive while we are here: leave a pending request that
            // the host consumes when it reloads, and notify a host that is still listening.
            EventBus.RequestNextQuestion(quizSession.Id);
            await EventBus.PublishAsync(new QuizEvent { Type = QuizEventType.NextQuestionRequested, SessionId = quizSession.Id });
            await ActivityLogService.LogActivityAsync("Next question requested", $"Session: {quizSession.SessionCode}", "Info", source: "Leaderboard");

            // Navigate back to the QuizHost page with session code
            Navigation.NavigateTo($"/quiz-host/{quizSession.QuizId}/{quizSession.SessionCode}");

            await ActivityLogService.LogActivityAsync("Navigated back to QuizHost", $"Quiz ID: {quizSession.QuizId}, Session: {quizSession.SessionCode}", "Info", source: "Leaderboard");
        }
        catch (Exception ex)
        {
            await ActivityLogService.LogActivityAsync("Next question error", ex.Message, "Error", source: "Leaderboard");
            errorMessage = L.T("Terjadi kesalahan saat meminta pertanyaan berikutnya.", "An error occurred while requesting the next question.");
        }
        finally
        {
            processingNextQuestion = false;
            StateHasChanged();
        }
    }

    private async Task RefreshLeaderboardData()
    {
        try
        {
            if (quizSession != null)
            {
                leaderboardEntries = await QuizService.GetLeaderboardAsync(quizSession.Id);
                totalParticipants = leaderboardEntries.Count;

                // Also refresh quiz status
                await LoadQuizStatus();

                await InvokeAsync(StateHasChanged);
            }
        }
        catch (Exception ex)
        {
            await ActivityLogService.LogActivityAsync("Refresh leaderboard error", ex.Message, "Error", source: "Leaderboard");
        }
    }

    private async Task RefreshLeaderboard()
    {
        await RefreshLeaderboardData();
        await ActivityLogService.LogActivityAsync("Leaderboard manually refreshed", $"Session: {quizSession?.SessionCode}", "Info", source: "Leaderboard");
    }

    private void ResetSession()
    {
        hasSessionCode = false;
        sessionCodeInput = string.Empty;
        errorMessage = string.Empty;
        leaderboardEntries.Clear();
        quizSession = null;
        totalParticipants = 0;

        // BARU: Reset quiz status
        quizCompleted = false;
        currentQuestionNumber = 0;
        totalQuestions = 0;
        hasMoreQuestions = true;

        refreshTimer?.Dispose();
        eventSubscription?.Dispose();
        Navigation.NavigateTo("/leaderboard", false);
    }

    private string GetRelativeTime(DateTime dateTime)
    {
        var timeSpan = DateTime.UtcNow - dateTime;

        if (timeSpan.TotalMinutes < 1)
            return L.T("Baru saja", "Just now");
        else if (timeSpan.TotalMinutes < 60)
            return L.T($"{(int)timeSpan.TotalMinutes} menit lalu", $"{(int)timeSpan.TotalMinutes} min ago");
        else if (timeSpan.TotalHours < 24)
            return L.T($"{(int)timeSpan.TotalHours} jam lalu", $"{(int)timeSpan.TotalHours} h ago");
        else
            return dateTime.ToString("dd/MM HH:mm");
    }

    public ValueTask DisposeAsync()
    {
        disposed = true;
        refreshTimer?.Dispose();
        eventSubscription?.Dispose();
        return ValueTask.CompletedTask;
    }
}
