@page "/quiz"
@page "/quiz/{SessionCode}"
@using BlazorQuiz.Models
@using BlazorQuiz.Services
@layout Components.Layout.EmptyLayout
@inject NavigationManager Navigation
@inject IQuizService QuizService
@inject IActivityLogService ActivityLogService
@inject IQuizEventBus EventBus
@implements IAsyncDisposable
@rendermode InteractiveServer

<PageTitle>@L.T("Gabung Quiz", "Join Quiz")</PageTitle>

<div class="container mt-4">
    <div class="row">
        <!-- Main Quiz Panel -->
        <div class="col-lg-8">
            <div class="card">
                <div class="card-header">
                    <div class="d-flex justify-content-between align-items-center gap-2">
                        <div class="min-w-0">
                            <h3 class="mb-0">
                                <i class="bi bi-person-fill"></i> @L.T("Gabung Quiz", "Join Quiz")
                            </h3>
                            @if (!string.IsNullOrEmpty(playerName) && quizSession != null)
                            {
                                <small class="text-muted d-block">@playerName · @L.T("Kode", "Code") @quizSession.SessionCode</small>
                            }
                            @if (quizSession != null)
                            {
                                <small class="text-muted d-block text-truncate">@(quizSession.Quiz?.Title ?? L.T("Memuat...", "Loading..."))</small>
                            }
                        </div>

                        <!-- Score Display with Ranking -->
                        @if (joinedSession && currentQuestion != null && (totalScore > 0 || totalAnswered > 0 || currentRank > 0))
                        {
                            <div class="text-end">
                                <div class="score-display">
                                    <div class="d-flex flex-column align-items-end">
                                        @if (currentRank > 0)
                                        {
                                            <div class="rank-display mb-2">
                                                <div class="d-flex align-items-center">
                                                    @if (currentRank <= 3)
                                                    {
                                                        <i class="bi bi-trophy-fill me-1 @GetRankColor(currentRank)"></i>
                                                    }
                                                    else
                                                    {
                                                        <i class="bi bi-award me-1 text-info"></i>
                                                    }
                                                    <span class="fw-bold fs-4 @GetRankColor(currentRank)">
                                                        #@currentRank
                                                    </span>
                                                </div>
                                                <small class="text-muted text-nowrap">@L.T("dari", "of") @totalParticipants</small>
                                            </div>
                                        }
                                        <div class="score-item">
                                            <i class="bi bi-trophy-fill text-warning me-1"></i>
                                            <span class="fw-bold text-primary fs-5">@totalScore</span>
                                            <small class="text-muted">@L.T("poin", "pts")</small>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
                <div class="card-body">
                    @if (!joinedSession)
                    {
                        <div class="mb-4">
                            <div class="d-flex justify-content-end align-items-center gap-2 mb-3"><ThemeToggle /><LanguageSwitcher /></div>
                            <label for="session-code" class="form-label">@L.T("Kode Sesi Quiz:", "Quiz Session Code:")</label>
                            <input id="session-code" class="form-control mb-3" @bind="sessionCodeInput" @bind:event="oninput"
                                placeholder="@L.T("Masukkan kode sesi...", "Enter session code...")" />

                            <label for="player-name" class="form-label">@L.T("Nama Anda:", "Your Name:")</label>
                            <input id="player-name" class="form-control mb-3" @bind="playerNameInput" @bind:event="oninput"
                                placeholder="@L.T("Masukkan nama Anda...", "Enter your name...")" />

                            <button class="btn btn-primary btn-lg w-100" type="button" @onclick="JoinSession" disabled="@joiningSession">
                                @if (joiningSession)
                                {
                                    <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                    <span>@L.T("Bergabung...", "Joining...")</span>
                                }
                                else
                                {
                                    <i class="bi bi-box-arrow-in-right"></i> <span>@L.T("Gabung", "Join")</span>
                                }
                            </button>
                        </div>
                    }
                    else if (currentQuestion != null)
                    {
                        <div class="card border-success mb-4">
                            <div class="card-header bg-success text-white">
                                <div class="d-flex justify-content-between align-items-center flex-nowrap gap-2">
                                    <h5 class="mb-0 text-nowrap">@L.T("Soal", "Question") @(currentQuestionIndex)</h5>
                                    @if (!answered)
                                    {
                                        <div class="d-flex align-items-center">
                                            <i class="bi bi-clock me-2 quiz-timer-icon"></i>
                                            <span class="quiz-timer @GetTimerClass()">@timeRemaining</span>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="d-flex align-items-center">
                                            <i class="bi bi-check-circle me-2"></i>
                                            <span class="fw-bold text-nowrap">@(selectedAnswer == -1 ? L.T("Tidak dijawab", "Not answered") : L.T("Dijawab", "Answered"))</span>
                                        </div>
                                    }
                                </div>
                            </div>
                            <div class="card-body">
                                <h4 class="mb-4">@currentQuestion.Text</h4>

                                @if (!answered)
                                {
                                    <div class="d-grid gap-3">
                                        @for (int i = 0; i < currentQuestion.Options.Count; i++)
                                        {
                                            var optionIndex = i;
                                            <button class="btn btn-lg text-start py-3 quiz-option quiz-option-@optionIndex"
                                                    type="button"
                                                    @onclick="@(() => SubmitAnswer(optionIndex))"
                                                    disabled="@answered">
                                                <div class="d-flex align-items-center">
                                                    <div class="shape-icon @GetShapeClass(optionIndex)"></div>
                                                    <span>@currentQuestion.Options[optionIndex]</span>
                                                </div>
                                            </button>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <div class="d-grid gap-3">
                                        @if (!showAnswerResult)
                                        {
                                            @* Before timer=0: show neutral/disabled options *@
                                            @for (int i = 0; i < currentQuestion.Options.Count; i++)
                                            {
                                                var optionIndex = i;
                                                var isSelected = selectedAnswer == optionIndex;
                                                <div class="btn btn-lg text-start py-3 quiz-option quiz-option-@optionIndex @(isSelected ? "" : "fade-out")">
                                                    <div class="d-flex align-items-center">
                                                        <div class="shape-icon @GetShapeClass(optionIndex)"></div>
                                                        <span>@currentQuestion.Options[optionIndex]</span>
                                                    </div>
                                                </div>
                                            }
                                        }
                                        else
                                        {
                                            @* After timer=0: show result with highlights *@
                                            @for (int i = 0; i < currentQuestion.Options.Count; i++)
                                            {
                                                var optionIndex = i;
                                                var isSelected = selectedAnswer == optionIndex;
                                                var isCorrect = currentQuestion.CorrectOptionIndex == optionIndex;

                                                <div class="btn btn-lg text-start py-3 @GetKahootOptionClass(optionIndex)">
                                                    <div class="d-flex align-items-center justify-content-between">
                                                        <div class="d-flex align-items-center">
                                                            <span class="badge option-number me-3 fs-6">@(optionIndex + 1)</span>
                                                            <span>@currentQuestion.Options[optionIndex]</span>
                                                        </div>
                                                        @if (isCorrect)
                                                        {
                                                            <i class="bi bi-check-circle-fill fs-4"></i>
                                                        }
                                                        @if (isSelected && !isCorrect)
                                                        {
                                                            <i class="bi bi-x-circle-fill fs-4"></i>
                                                        }
                                                    </div>
                                                </div>
                                            }
                                        }
                                    </div>

                                    <div class="mt-3 p-3 answer-result-card rounded">
                                        @if (lastAnswerResult != null && showAnswerResult)
                                        {
                                            <div class="row align-items-center">
                                                <div class="col-md-6">
                                                    <div class="d-flex align-items-center">
                                                        @if (lastAnswerResult.IsCorrect)
                                                        {
                                                            <i class="bi bi-check-circle-fill text-success me-2 fs-4"></i>
                                                            <div>
                                                                <span class="text-success fw-bold fs-5">@L.T("Benar!", "Correct!")</span>
                                                                <div class="small text-muted">
                                                                    +@lastAnswerResult.Points @L.T("poin", "pts") · @(lastAnswerResult.TimeTakenMs)ms
                                                                </div>
                                                            </div>
                                                        }
                                                        else if (selectedAnswer == -1)
                                                        {
                                                            <i class="bi bi-clock-fill text-warning me-2 fs-4"></i>
                                                            <div>
                                                                <span class="text-warning fw-bold fs-5">@L.T("Waktu Habis!", "Time's Up!")</span>
                                                                <div class="small text-muted">
                                                                    +0 @L.T("poin", "pts") · @L.T("Tidak ada jawaban dikirim", "No answer submitted")
                                                                </div>
                                                            </div>
                                                        }
                                                        else
                                                        {
                                                            <i class="bi bi-x-circle-fill text-danger me-2 fs-4"></i>
                                                            <div>
                                                                <span class="text-danger fw-bold fs-5">@L.T("Salah!", "Wrong!")</span>
                                                                <div class="small text-muted">
                                                                    +0 @L.T("poin", "pts") · @(lastAnswerResult.TimeTakenMs)ms
                                                                </div>
                                                            </div>
                                                        }
                                                    </div>
                                                </div>
                                                <div class="col-md-6 text-end">
                                                    <div class="score-update">
                                                        <div class="small text-muted">@L.T("Posisi Anda", "Your Position")</div>
                                                        @if (currentRank > 0)
                                                        {
                                                            <div class="fw-bold @GetRankColor(currentRank) fs-3">
                                                                #@currentRank
                                                            </div>
                                                            <div class="small text-muted">@L.T("dari", "of") @totalParticipants</div>
                                                        }
                                                        else
                                                        {
                                                            <div class="fw-bold text-primary fs-4">@totalScore</div>
                                                        }
                                                    </div>
                                                </div>
                                            </div>

                                            <!-- View Leaderboard Button -->
                                            <div class="text-center mt-3">
                                                <a href="/leaderboard/@(quizSession?.SessionCode)" class="btn btn-outline-primary btn-sm me-2">
                                                    <i class="bi bi-trophy me-1"></i> @L.T("Lihat Leaderboard", "View Leaderboard")
                                                </a>
                                                <small class="text-muted d-block mt-1">@L.T("Klik untuk melihat peringkat lengkap", "Click to see the full ranking")</small>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    }
                    else if (waitingForQuestion)
                    {
                        <div class="text-center py-5">
                            <div class="spinner-border text-primary mb-3" role="status">
                                <span class="visually-hidden">@L.T("Memuat...", "Loading...")</span>
                            </div>
                            <h5>@L.T("Menunggu pertanyaan berikutnya...", "Waiting for the next question...")</h5>
                            @if (totalAnswered > 0)
                            {
                                <div class="mt-3">
                                    <div class="card bg-light">
                                        <div class="card-body">
                                            <h6 class="card-title">@L.T("Status Anda Saat Ini", "Your Current Status")</h6>
                                            <div class="row text-center">
                                                <div class="col-3">
                                                    @if (currentRank > 0)
                                                    {
                                                        <div class="fs-2 fw-bold @GetRankColor(currentRank)">
                                                            #@currentRank
                                                        </div>
                                                        <small class="text-muted">@L.T("Peringkat", "Rank")</small>
                                                    }
                                                    else
                                                    {
                                                        <div class="fs-2 fw-bold text-muted">-</div>
                                                        <small class="text-muted">@L.T("Peringkat", "Rank")</small>
                                                    }
                                                </div>
                                                <div class="col-3">
                                                    <div class="fs-2 fw-bold text-primary">@totalScore</div>
                                                    <small class="text-muted">@L.T("Poin", "Points")</small>
                                                </div>
                                                <div class="col-3">
                                                    <div class="fs-2 fw-bold text-success">@totalCorrect</div>
                                                    <small class="text-muted">@L.T("Benar", "Correct")</small>
                                                </div>
                                                <div class="col-3">
                                                    <div class="fs-2 fw-bold text-info">@(((double)totalCorrect / totalAnswered * 100).ToString("F1"))%</div>
                                                    <small class="text-muted">@L.T("Akurasi", "Accuracy")</small>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else if (joinedSession && !quizCompleted)
                    {
                        <div class="text-center py-5">
                            <i class="bi bi-clock display-1 text-info mb-3"></i>
                            <h4>@L.T("Anda telah bergabung!", "You have joined!")</h4>
                            <p class="text-muted">@L.T("Menunggu host untuk memulai quiz...", "Waiting for the host to start the quiz...")</p>
                            @if (totalParticipants > 1)
                            {
                                <div class="mt-3">
                                    <small class="text-muted">@totalParticipants @L.T("peserta sudah bergabung", "participants have joined")</small>
                                </div>
                            }
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(statusMessage) && showAnswerResult)
                    {
                        <div class="alert @(statusMessage.Contains("Error") ? "alert-danger" : "alert-info") mt-3" role="alert">
                            @statusMessage
                        </div>
                    }
                </div>
            </div>

            <!-- Quiz Summary Card (shown when quiz is completed) -->
            @if (quizCompleted && totalAnswered > 0)
            {
                <div class="card mt-4 border-success">
                    <div class="card-header bg-success text-white text-center py-3">
                        <h3 class="mb-0 fw-bold">
                            <i class="bi bi-flag-checkered me-2"></i>@L.T("Quiz Selesai!", "Quiz Completed!")
                        </h3>
                        @if (finalRank > 0)
                        {
                            <p class="mb-0 mt-2 opacity-90">
                                <i class="bi bi-trophy me-1"></i>
                                @L.T("Peringkat Final:", "Final Rank:") <strong class="fs-5">#@finalRank</strong> @L.T("dari", "of") @totalParticipants @L.T("peserta", "participants")
                            </p>
                        }
                    </div>
                    <div class="card-body p-4">
                        <!-- Statistics Grid -->
                        <div class="row g-3 mb-4">
                            <div class="col-6 col-lg-2 col-md-4">
                                <div class="final-stat-card rank-card h-100">
                                    @if (finalRank > 0)
                                    {
                                        @if (finalRank <= 3)
                                        {
                                            <i class="bi bi-trophy-fill fs-1 @GetRankColor(finalRank) mb-3"></i>
                                        }
                                        else
                                        {
                                            <i class="bi bi-award fs-1 text-info mb-3"></i>
                                        }
                                        <div class="fs-1 fw-bold @GetRankColor(finalRank)">#@finalRank</div>
                                        <div class="text-muted small mt-1">@L.T("Peringkat", "Rank")</div>
                                    }
                                    else
                                    {
                                        <i class="bi bi-person fs-1 text-muted mb-3"></i>
                                        <div class="fs-1 fw-bold text-muted">-</div>
                                        <div class="text-muted small mt-1">@L.T("Peringkat", "Rank")</div>
                                    }
                                </div>
                            </div>
                            <div class="col-6 col-lg-2 col-md-4">
                                <div class="final-stat-card score-card h-100">
                                    <i class="bi bi-trophy-fill fs-1 text-warning mb-3"></i>
                                    <div class="fs-1 fw-bold text-primary">@totalScore</div>
                                    <div class="text-muted small mt-1">@L.T("Total Poin", "Total Points")</div>
                                </div>
                            </div>
                            <div class="col-6 col-lg-2 col-md-4">
                                <div class="final-stat-card correct-card h-100">
                                    <i class="bi bi-check-circle-fill fs-1 text-success mb-3"></i>
                                    <div class="fs-1 fw-bold text-success">@totalCorrect</div>
                                    <div class="text-muted small mt-1">@L.T("Jawaban Benar", "Correct Answers")</div>
                                </div>
                            </div>
                            <div class="col-6 col-lg-2 col-md-4">
                                <div class="final-stat-card incorrect-card h-100">
                                    <i class="bi bi-x-circle-fill fs-1 text-danger mb-3"></i>
                                    <div class="fs-1 fw-bold text-danger">@(totalAnswered - totalCorrect)</div>
                                    <div class="text-muted small mt-1">@L.T("Salah / Tidak Dijawab", "Wrong / Unanswered")</div>
                                </div>
                            </div>
                            <div class="col-12 col-lg-4 col-md-8">
                                <div class="final-stat-card accuracy-card h-100">
                                    <i class="bi bi-percent fs-1 text-info mb-3"></i>
                                    <div class="fs-1 fw-bold text-info">@(((double)totalCorrect / totalAnswered * 100).ToString("F1"))%</div>
                                    <div class="text-muted small mt-1">@L.T("Akurasi", "Accuracy")</div>
                                </div>
                            </div>
                        </div>

                        <!-- Achievement Messages -->
                        @if (totalCorrect == 0)
                        {
                            <div class="achievement-banner good-effort">
                                <div class="d-flex align-items-center">
                                    <i class="bi bi-emoji-neutral fs-2 text-primary me-3"></i>
                                    <div>
                                        <h4 class="mb-1 fw-bold text-primary">@L.T("Belum ada jawaban benar", "No correct answers yet")</h4>
                                        <p class="mb-0 text-muted">@L.T("Coba lagi di quiz berikutnya. Jawab sebelum waktu habis.", "Try again in the next quiz. Answer before time runs out.")</p>
                                    </div>
                                </div>
                            </div>
                        }
                        else if (finalRank == 1)
                        {
                            <div class="achievement-banner winner-gold">
                                <div class="d-flex align-items-center">
                                    <i class="bi bi-trophy-fill fs-2 me-3"></i>
                                    <div>
                                        <h4 class="mb-1 fw-bold">@L.T("Selamat! Anda Juara 1!", "Congratulations! You are 1st place!")</h4>
                                        <p class="mb-0">@L.T("Prestasi luar biasa! Anda adalah yang terbaik!", "Outstanding! You are the best!")</p>
                                    </div>
                                </div>
                            </div>
                        }
                        else if (finalRank == 2)
                        {
                            <div class="achievement-banner winner-silver">
                                <div class="d-flex align-items-center">
                                    <i class="bi bi-trophy-fill fs-2 me-3"></i>
                                    <div>
                                        <h4 class="mb-1 fw-bold">@L.T("Hebat! Anda Juara 2!", "Great! You are 2nd place!")</h4>
                                        <p class="mb-0">@L.T("Hasil yang sangat bagus! Terus pertahankan!", "A very good result! Keep it up!")</p>
                                    </div>
                                </div>
                            </div>
                        }
                        else if (finalRank == 3)
                        {
                            <div class="achievement-banner winner-bronze">
                                <div class="d-flex align-items-center">
                                    <i class="bi bi-trophy-fill fs-2 me-3"></i>
                                    <div>
                                        <h4 class="mb-1 fw-bold">@L.T("Bagus! Anda Juara 3!", "Well done! You are 3rd place!")</h4>
                                        <p class="mb-0">@L.T("Masuk podium! Pencapaian yang membanggakan!", "On the podium! Something to be proud of!")</p>
                                    </div>
                                </div>
                            </div>
                        }
                        else if (finalRank <= 5)
                        {
                            <div class="achievement-banner top-five">
                                <div class="d-flex align-items-center">
                                    <i class="bi bi-star-fill fs-2 text-info me-3"></i>
                                    <div>
                                        <h4 class="mb-1 fw-bold text-info">@L.T("Luar biasa! Top 5 peserta!", "Excellent! Top 5 participant!")</h4>
                                        <p class="mb-0 text-muted">@L.T("Anda termasuk dalam 5 terbaik! Kerja bagus!", "You are among the top 5! Good job!")</p>
                                    </div>
                                </div>
                            </div>
                        }
                        else if (totalCorrect == totalAnswered)
                        {
                            <div class="achievement-banner perfect-score">
                                <div class="d-flex align-items-center">
                                    <i class="bi bi-award-fill fs-2 text-success me-3"></i>
                                    <div>
                                        <h4 class="mb-1 fw-bold text-success">@L.T("Sempurna!", "Perfect!")</h4>
                                        <p class="mb-0 text-muted">@L.T("Anda menjawab semua pertanyaan dengan benar!", "You answered every question correctly!")</p>
                                    </div>
                                </div>
                            </div>
                        }
                        else if (totalCorrect >= totalAnswered * 0.8)
                        {
                            <div class="achievement-banner good-score">
                                <div class="d-flex align-items-center">
                                    <i class="bi bi-emoji-smile fs-2 text-success me-3"></i>
                                    <div>
                                        <h4 class="mb-1 fw-bold text-success">@L.T("Skor tinggi!", "High score!")</h4>
                                        <p class="mb-0 text-muted">@L.T("Skor yang sangat bagus! Terus tingkatkan!", "A very good score! Keep improving!")</p>
                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="achievement-banner good-effort">
                                <div class="d-flex align-items-center">
                                    <i class="bi bi-hand-thumbs-up fs-2 text-primary me-3"></i>
                                    <div>
                                        <h4 class="mb-1 fw-bold text-primary">@L.T("Usaha yang Baik!", "Good Effort!")</h4>
                                        <p class="mb-0 text-muted">@L.T("Terus berlatih dan tingkatkan kemampuan Anda!", "Keep practicing and improve your skills!")</p>
                                    </div>
                                </div>
                            </div>
                        }

                        <!-- Action Buttons -->
                        <div class="text-center mt-4">
                            <a href="/leaderboard/@(quizSession?.SessionCode)" class="btn btn-success btn-lg me-2 mb-2">
                                <i class="bi bi-trophy-fill me-2"></i>@L.T("Lihat Leaderboard Lengkap", "View Full Leaderboard")
                            </a>
                            <button class="btn btn-outline-secondary me-2 mb-2" onclick="window.print()">
                                <i class="bi bi-printer me-2"></i>@L.T("Cetak Hasil", "Print Results")
                            </button>
                            <a href="/quiz" class="btn btn-primary mb-2">
                                <i class="bi bi-arrow-repeat me-2"></i>@L.T("Main Lagi", "Play Again")
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Sidebar with Mini Leaderboard -->
        <div class="col-lg-4">
            @if (joinedSession && showAnswerResult && miniLeaderboard.Any(entry => entry.TotalScore > 0) && totalAnswered > 0)
            {
                <div class="card">
                    <div class="card-header">
                        <h6 class="mb-0">
                            <i class="bi bi-bar-chart"></i> Mini Leaderboard
                        </h6>
                        <small class="text-muted">@L.T("Posisi Anda:", "Your position:") #@currentRank @L.T("dari", "of") @totalParticipants</small>
                    </div>
                    <div class="card-body mini-leaderboard">
                        @foreach (var (entry, index) in miniLeaderboard.Where(e => e.TotalScore > 0).Take(10).Select((entry, index) => (entry, index)))
                        {
                            var isCurrentPlayer = entry.ParticipantName == playerName;
                            <div class="d-flex justify-content-between align-items-center py-2 px-3 mb-2 @(isCurrentPlayer ? "bg-primary text-white rounded" : "")">
                                <div class="d-flex align-items-center">
                                    <div class="rank-badge me-2">
                                        @if (index < 3)
                                        {
                                            <span class="badge @(index == 0 ? "bg-warning" : index == 1 ? "bg-secondary" : "bg-primary")">
                                                @(index + 1)
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge @(isCurrentPlayer ? "bg-light text-dark" : "bg-light text-muted")">@(index + 1)</span>
                                        }
                                    </div>
                                    <div class="participant-mini-avatar me-2 @(isCurrentPlayer ? "bg-light text-primary" : "")">
                                        @entry.ParticipantName.Substring(0, 1).ToUpper()
                                    </div>
                                    <div>
                                        <div class="fw-bold @(isCurrentPlayer ? "text-white" : "")">
                                            @entry.ParticipantName
                                            @if (isCurrentPlayer) { <small>(@L.T("Anda", "You"))</small> }
                                        </div>
                                        <small class="@(isCurrentPlayer ? "text-light" : "text-muted")">
                                            @entry.Accuracy.ToString("F1")% @L.T("akurat", "accurate")
                                        </small>
                                    </div>
                                </div>
                                <div class="text-end">
                                    <div class="fw-bold @(isCurrentPlayer ? "text-white" : "text-primary")">@entry.TotalScore</div>
                                    <small class="@(isCurrentPlayer ? "text-light" : "text-muted")">@L.T("poin", "pts")</small>
                                </div>
                            </div>
                        }

                        @if (miniLeaderboard.Count(e => e.TotalScore > 0) > 10)
                        {
                            <div class="text-center mt-2">
                                <small class="text-muted">... @L.T("dan", "and") @(miniLeaderboard.Count(e => e.TotalScore > 0) - 10) @L.T("lainnya", "more")</small>
                            </div>
                        }
                    </div>
                </div>
            }

            @if (joinedSession && showAnswerResult && currentRank > 0 && totalAnswered > 0)
            {
                <div class="card mt-3">
                    <div class="card-body text-center">
                        <h6 class="card-title">
                            <i class="bi bi-target"></i> @L.T("Target Anda", "Your Target")
                        </h6>
                        @if (currentRank > 1)
                        {
                            var nextTarget = miniLeaderboard.Skip(currentRank - 2).FirstOrDefault();
                            if (nextTarget != null)
                            {
                                var pointsNeeded = nextTarget.TotalScore - totalScore;
                                <div class="target-info">
                                    <div class="small text-muted">@L.T("Untuk naik ke posisi", "To move up to position") #@(currentRank - 1):</div>
                                    <div class="fw-bold text-primary">
                                        @if (pointsNeeded > 0)
                                        {
                                            <span>+@pointsNeeded @L.T("poin lagi", "more pts")</span>
                                        }
                                        else
                                        {
                                            <span class="text-success">@L.T("Anda sudah unggul!", "You are already ahead!")</span>
                                        }
                                    </div>
                                    <div class="small text-muted">vs @nextTarget.ParticipantName</div>
                                </div>
                            }
                        }
                        else if (totalScore > 0)
                        {
                            <div class="text-success">
                                <i class="bi bi-crown-fill"></i>
                                <div class="fw-bold">@L.T("Anda memimpin!", "You are leading!")</div>
                                <small>@L.T("Pertahankan posisi Anda", "Keep your position")</small>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@code {
    [Parameter] public string? SessionCode { get; set; }

    private QuizSession? quizSession;
    private QuizParticipant? participant;
    private Question? currentQuestion;
    private int currentQuestionIndex = 0;
    private IDisposable? eventSubscription;
    private bool disposed;
    private string playerName = string.Empty;
    private string playerNameInput = string.Empty;
    private string sessionCodeInput = string.Empty;
    private bool answered = false;
    private int selectedAnswer = -1;
    private DateTime questionStartTime;
    private int timeRemaining = 15; // Changed from 5 to 15 seconds per question
    private Timer? countdownTimer;
    private Timer? leaderboardRefreshTimer;
    private string statusMessage = string.Empty;
    private bool joinedSession = false;
    private bool joiningSession = false;
    private bool waitingForQuestion = false;
    private bool quizCompleted = false;
    private QuizAnswer? lastAnswerResult;

    // Score tracking
    private int totalScore = 0;
    private int totalCorrect = 0;
    private int totalAnswered = 0;

    // Ranking tracking
    private int currentRank = 0;
    private int finalRank = 0;
    private int totalParticipants = 0;
    private List<LeaderboardEntry> miniLeaderboard = new List<LeaderboardEntry>();
    private bool showAnswerResult = false;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await ActivityLogService.LogActivityAsync("QuizUser initialized", "Quiz user component starting", "Info", source: "QuizUser");

            // If session code is provided in URL, pre-fill it
            if (!string.IsNullOrEmpty(SessionCode))
            {
                sessionCodeInput = SessionCode;
                await ActivityLogService.LogActivityAsync("Session code from URL", $"Session code: {SessionCode}", "Info", source: "QuizUser");
            }

            statusMessage = L.T("Masukkan kode sesi dan nama untuk bergabung.", "Enter the session code and your name to join.");
        }
        catch (Exception ex)
        {
            await ActivityLogService.LogActivityAsync("QuizUser initialization error", ex.Message, "Error", source: "QuizUser");
            statusMessage = $"Error: {ex.Message}";
        }
    }

    private Task OnQuizEvent(QuizEvent e)
    {
        if (disposed) return Task.CompletedTask;
        return InvokeAsync(async () =>
        {
            if (disposed) return;
            switch (e.Type)
            {
                case QuizEventType.Question when e.Question != null:
                    HandleQuestion(e.Question);
                    break;
                case QuizEventType.RevealAnswer:
                    showAnswerResult = true;
                    await RefreshLeaderboard(); // cached/single-flight, so the final standing is exact at reveal
                    StateHasChanged();
                    break;
                case QuizEventType.QuizCompleted:
                    await HandleQuizCompleted();
                    break;
                case QuizEventType.LeaderboardUpdated:
                    await RefreshLeaderboard();
                    break;
            }
        });
    }

    private void HandleQuestion(QuestionDto questionDto)
    {
        // Convert DTO back to Question for local use
        currentQuestion = new Question
        {
            Id = questionDto.Id,
            Text = questionDto.Text,
            Options = questionDto.Options,
            CorrectOptionIndex = questionDto.CorrectOptionIndex,
            OrderIndex = questionDto.OrderIndex
        };

        currentQuestionIndex = questionDto.OrderIndex + 1;
        answered = false;
        selectedAnswer = -1;
        lastAnswerResult = null;
        timeRemaining = 15;
        questionStartTime = DateTime.UtcNow;
        waitingForQuestion = false;
        showAnswerResult = false; // Reset for new question

        // Start countdown (display only; scoring time is measured on the server)
        countdownTimer?.Dispose();
        countdownTimer = new Timer(UpdateTimer, null, TimeSpan.Zero, TimeSpan.FromSeconds(1));

        StateHasChanged();
    }

    private async Task HandleQuizCompleted()
    {
        quizCompleted = true;
        currentQuestion = null;
        waitingForQuestion = false;
        countdownTimer?.Dispose();
        leaderboardRefreshTimer?.Dispose();

        // Get final ranking
        await RefreshLeaderboard();
        finalRank = currentRank;

        await ActivityLogService.LogActivityAsync("Quiz completed", $"Final rank: {finalRank}, Score: {totalScore}", "Info", source: "QuizUser", userName: playerName);
        StateHasChanged();
    }

    protected override async Task OnParametersSetAsync()
    {
        // Update session code input when parameter changes
        if (!string.IsNullOrEmpty(SessionCode))
        {
            sessionCodeInput = SessionCode;
            StateHasChanged();
        }
    }

    private async Task RefreshLeaderboard()
    {
        try
        {
            if (quizSession != null)
            {
                miniLeaderboard = await QuizService.GetLeaderboardAsync(quizSession.Id);
                totalParticipants = miniLeaderboard.Count;

                // Find current player's rank
                var playerEntry = miniLeaderboard.FirstOrDefault(x => x.ParticipantName == playerName);
                if (playerEntry != null)
                {
                    currentRank = miniLeaderboard.IndexOf(playerEntry) + 1;
                }
            }
        }
        catch (Exception ex)
        {
            await ActivityLogService.LogActivityAsync("Leaderboard refresh error", ex.Message, "Error", source: "QuizUser", userName: playerName);
        }
        await InvokeAsync(StateHasChanged); // Pastikan UI refresh di Dispatcher
    }

    private async Task JoinSession()
    {
        try
        {
            joiningSession = true;
            statusMessage = L.T("Bergabung ke sesi...", "Joining session...");
            StateHasChanged();

            if (string.IsNullOrWhiteSpace(sessionCodeInput))
            {
                statusMessage = L.T("Masukkan kode sesi!", "Enter the session code!");
                return;
            }

            if (string.IsNullOrWhiteSpace(playerNameInput))
            {
                statusMessage = L.T("Masukkan nama Anda!", "Enter your name!");
                return;
            }

            // Find the quiz session
            quizSession = await QuizService.GetActiveQuizSessionAsync(sessionCodeInput.Trim().ToUpper());

            if (quizSession == null)
            {
                statusMessage = L.T("Kode sesi tidak ditemukan atau sesi sudah tidak aktif!", "Session code not found or the session is no longer active!");
                await ActivityLogService.LogActivityAsync("Session join failed", $"Session code not found: {sessionCodeInput}", "Warning", source: "QuizUser");
                return;
            }

            // Add participant to session
            var connectionId = Guid.NewGuid().ToString();
            participant = await QuizService.AddParticipantAsync(quizSession.Id, playerNameInput.Trim(), connectionId);

            playerName = participant.PlayerName;
            joinedSession = true;
            waitingForQuestion = true;

            // Load existing scores if participant was already in the quiz
            totalScore = participant.TotalScore;
            totalCorrect = participant.TotalCorrectAnswers;
            totalAnswered = participant.TotalAnswers;

            statusMessage = L.T($"Berhasil bergabung ke quiz '{quizSession.Quiz?.Title}'. Menunggu host memulai...", $"Joined quiz '{quizSession.Quiz?.Title}'. Waiting for the host to start...");

            // Start leaderboard refresh timer
            // TIMER REMOVED TO PREVENT DB OVERLOAD

            // Notify all clients (including host) that a new participant joined
            eventSubscription?.Dispose();
            eventSubscription = EventBus.Subscribe(quizSession.Id, OnQuizEvent);
            await EventBus.PublishAsync(new QuizEvent { Type = QuizEventType.ParticipantJoined, SessionId = quizSession.Id, PlayerName = playerName });

            await ActivityLogService.LogActivityAsync("Session joined", $"Player: {playerName}, Quiz: {quizSession.Quiz?.Title}, Session: {sessionCodeInput}", "Info", source: "QuizUser", userName: playerName);
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await ActivityLogService.LogActivityAsync("Session join error", ex.Message, "Error", source: "QuizUser", userName: playerNameInput);
            statusMessage = L.T($"Error bergabung: {ex.Message}", $"Error joining: {ex.Message}");
            StateHasChanged();
        }
        finally
        {
            joiningSession = false;
            StateHasChanged();
        }
    }

    private async Task SubmitAnswer(int optionIndex)
    {
        // Lock the answer synchronously so a click and the timeout can't both submit
        if (answered || participant == null || quizSession == null || currentQuestion == null)
            return;
        answered = true;
        selectedAnswer = optionIndex;
        countdownTimer?.Dispose();

        try
        {
            var sessionId = quizSession.Id;
            var questionId = currentQuestion.Id;

            // Time and score are computed on the server
            lastAnswerResult = await QuizService.SubmitAnswerAsync(sessionId, questionId, participant.Id, optionIndex);

            totalAnswered++;
            totalScore += lastAnswerResult.Points;
            if (lastAnswerResult.IsCorrect)
            {
                totalCorrect++;
            }

            await EventBus.PublishAsync(new QuizEvent
            {
                Type = QuizEventType.ScoreboardUpdated,
                SessionId = sessionId,
                PlayerName = playerName,
                TimeTaken = lastAnswerResult.TimeTakenMs,
                IsCorrect = lastAnswerResult.IsCorrect,
                Points = lastAnswerResult.Points
            });
            EventBus.RequestLeaderboardRefresh(sessionId);

            statusMessage = lastAnswerResult.IsCorrect ?
                L.T($"Benar! +{lastAnswerResult.Points} poin - Posisi: #{currentRank}", $"Correct! +{lastAnswerResult.Points} pts - Position: #{currentRank}") :
                L.T($"Jawaban salah - Posisi: #{currentRank}", $"Wrong answer - Position: #{currentRank}");

            waitingForQuestion = true;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await ActivityLogService.LogActivityAsync("Submit answer error", ex.Message, "Error", source: "QuizUser", userName: playerName);
            statusMessage = L.T($"Error mengirim jawaban: {ex.Message}", $"Error submitting answer: {ex.Message}");
            StateHasChanged();
        }
    }

    private void UpdateTimer(object? state)
    {
        if (disposed) return;
        _ = InvokeAsync(async () =>
        {
            if (disposed) return;
            if (timeRemaining > 0)
            {
                timeRemaining--;
                StateHasChanged();
                return;
            }

            // Time's up - show results for ALL participants
            countdownTimer?.Dispose();
            showAnswerResult = true;

            // Only handle timeout submission if not answered yet
            if (!answered && participant != null && quizSession != null && currentQuestion != null)
            {
                answered = true; // lock before any await
                selectedAnswer = -1; // Mark as no answer selected

                try
                {
                    var sessionId = quizSession.Id;
                    lastAnswerResult = await QuizService.SubmitAnswerAsync(sessionId, currentQuestion.Id, participant.Id, -1);

                    totalAnswered++;

                    await EventBus.PublishAsync(new QuizEvent
                    {
                        Type = QuizEventType.ScoreboardUpdated,
                        SessionId = sessionId,
                        PlayerName = playerName,
                        TimeTaken = lastAnswerResult.TimeTakenMs
                    });
                    await EventBus.PublishAsync(new QuizEvent { Type = QuizEventType.ParticipantTimeout, SessionId = sessionId, PlayerName = playerName });
                    EventBus.RequestLeaderboardRefresh(sessionId);

                    statusMessage = L.T($"Waktu habis! Tidak ada jawaban dikirim - Posisi: #{currentRank}", $"Time's up! No answer submitted - Position: #{currentRank}");
                    waitingForQuestion = true;
                }
                catch (Exception ex)
                {
                    await ActivityLogService.LogActivityAsync("Timeout submit error", ex.Message, "Error", source: "QuizUser", userName: playerName);
                }
            }

            StateHasChanged();
        });
    }

        private string GetKahootOptionClass(int optionIndex)
    {
        if (!answered || !showAnswerResult) return "quiz-option quiz-option-" + optionIndex;

        var isCorrect = currentQuestion?.CorrectOptionIndex == optionIndex;
        var isSelected = selectedAnswer == optionIndex;

        if (isCorrect)
            return "quiz-option quiz-option-" + optionIndex + " quiz-option-correct";
        if (isSelected && !isCorrect)
            return "quiz-option quiz-option-" + optionIndex + " quiz-option-wrong";

        return "quiz-option quiz-option-" + optionIndex + " fade-out";
    }

    private string GetShapeClass(int optionIndex)
    {
        return optionIndex switch
        {
            0 => "shape-triangle",
            1 => "shape-diamond",
            2 => "shape-circle",
            3 => "shape-square",
            _ => "shape-circle"
        };
    }

    private string GetAnswerButtonClass(int optionIndex)
    {
        if (!answered || !showAnswerResult) return "btn-outline-primary";

        var isCorrect = currentQuestion?.CorrectOptionIndex == optionIndex;
        var isSelected = selectedAnswer == optionIndex;

        // Prioritaskan highlight jawaban benar
        if (isCorrect)
            return "btn-success";
        // Jika dipilih peserta dan salah
        if (isSelected && !isCorrect)
            return "btn-danger";
        // Opsi lain
        return "btn-outline-secondary opacity-50";
    }

    private string GetAnswerBadgeClass(int optionIndex)
    {
        if (!answered || !showAnswerResult) return "bg-primary";

        var isCorrect = currentQuestion?.CorrectOptionIndex == optionIndex;
        var isSelected = selectedAnswer == optionIndex;

        if (isCorrect)
            return "bg-success";
        if (isSelected && !isCorrect)
            return "bg-danger";
        return "bg-secondary";
    }

    private string GetTimerClass()
    {
        if (timeRemaining <= 3)
            return "timer-danger";
        else if (timeRemaining <= 5)
            return "timer-warning";
        else
            return "timer-normal";
    }

    private string GetRankColor(int rank)
    {
        return rank switch
        {
            1 => "text-warning", // Gold
            2 => "text-secondary", // Silver
            3 => "text-primary", // Bronze (using primary blue instead of brown)
            <= 5 => "text-info", // Top 5
            _ => "text-muted" // Others
        };
    }

    public ValueTask DisposeAsync()
    {
        disposed = true;
        countdownTimer?.Dispose();
        leaderboardRefreshTimer?.Dispose();
        eventSubscription?.Dispose();
        return ValueTask.CompletedTask;
    }
}
