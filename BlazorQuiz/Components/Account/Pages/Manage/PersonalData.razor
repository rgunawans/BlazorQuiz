@page "/Account/Manage/PersonalData"

@inject IdentityUserAccessor UserAccessor

<PageTitle>@L.T("Data pribadi", "Personal data")</PageTitle>

<StatusMessage />
<h3>@L.T("Data pribadi", "Personal data")</h3>

<div class="row">
    <div class="col-md-6">
        <p>@L.T("Akun Anda berisi data pribadi yang Anda berikan. Halaman ini memungkinkan Anda mengunduh atau menghapus data tersebut.", "Your account contains personal data that you have given us. This page allows you to download or delete that data.")</p>
        <p>
            <strong>@L.T("Menghapus data ini akan menghapus akun Anda secara permanen dan tidak dapat dipulihkan.", "Deleting this data will permanently remove your account, and this cannot be recovered.")</strong>
        </p>
        <form action="Account/Manage/DownloadPersonalData" method="post">
            <AntiforgeryToken />
            <button class="btn btn-primary" type="submit">@L.T("Unduh", "Download")</button>
        </form>
        <p>
            <a href="Account/Manage/DeletePersonalData" class="btn btn-danger">@L.T("Hapus", "Delete")</a>
        </p>
    </div>
</div>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        _ = await UserAccessor.GetRequiredUserAsync(HttpContext);
    }
}
