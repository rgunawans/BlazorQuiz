<!DOCTYPE html>
<html lang="@L.Language">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <base href="/" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="_content/MudBlazor/MudBlazor.min.css" />
    <link rel="stylesheet" href="app.css" />
    <link rel="stylesheet" href="BlazorQuiz.styles.css" />
    <HeadOutlet />
</head>

<body>
    <Routes />

    <div id="blazor-error-ui" style="display: none;">
        @L.T("Terjadi kesalahan.", "An error has occurred.")
        <a href="" class="reload">@L.T("Muat ulang", "Reload")</a>
        <button type="button" class="dismiss" aria-label="@L.T("Tutup pesan kesalahan", "Dismiss error message")">&times;</button>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="_content/MudBlazor/MudBlazor.min.js"></script>
    <script src="_framework/blazor.web.js"></script>
    <script>
        // Sidebar toggle by delegation so it survives enhanced navigation.
        document.addEventListener("click", function (e) {
            if (e.target.closest("[data-ynex-toggle]")) { document.body.classList.toggle("ynex-sidebar-open"); }
            else if (e.target.closest(".ynex-menu-link")) { document.body.classList.remove("ynex-sidebar-open"); }
        });
    </script>
</body>

</html>
